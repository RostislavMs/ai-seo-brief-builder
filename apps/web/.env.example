# Скопіюйте у .env. Значення потрапляють у бандл — сюди можна класти
# лише публічні ключі (Supabase → Project Settings → API → Publishable key).
#
# Publishable-ключ безпечно віддавати браузеру: доступ до даних обмежує
# RLS, а всі операції з чужими даними йдуть лише через наш бекенд.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
