# ─── Supabase: авторизація та зберігання сесій ──────────────────────────────
# Dashboard → Project Settings → API.
# Без цих двох змінних працює лише /api/health: усе інше повертає 503.

NITRO_SUPABASE_URL=

# Secret key (sb_secret_… або legacy service_role). Обходить RLS — у фронт
# не потрапляє ніколи.
NITRO_SUPABASE_SECRET_KEY=

# Необов'язково: за замовчуванням береться
# {NITRO_SUPABASE_URL}/auth/v1/.well-known/jwks.json
# NITRO_SUPABASE_JWKS_URL=

# ─── Шифрування ключів користувачів ────────────────────────────────────────
# 32 байти в hex або base64: openssl rand -hex 32
# Ним шифруються ключі AI-провайдерів (user_ai_keys) і ключі платних сервісів
# доступу до сторінок (user_fetch_keys). Якщо змінити — збережені ключі стануть
# нечитабельними, і користувачам доведеться додати їх заново.

NITRO_ENCRYPTION_KEY=

# ─── Адміністратори ────────────────────────────────────────────────────────
# Пошти через кому. Акаунт із такою поштою отримує роль адміна при першому ж
# читанні профілю — це єдиний спосіб призначити першого адміна, не заходячи
# в SQL Editor. Далі роль лежить у profiles.role і від цієї змінної не
# залежить: прибрати пошту звідси прав не знімає.
#
# Адмін розглядає пропозиції правил для мов, пише власні, вмикає, вимикає
# й видаляє їх. Решта користувачів може лише пропонувати.

# NITRO_ADMIN_EMAILS=you@example.com,teammate@example.com

# ─── Стеля часу на роботу з моделлю ────────────────────────────────────────
# Мілісекунди. 0 — без стелі; так за замовчуванням локально, де ліміту
# тривалості запиту не існує.
#
# На Vercel за замовчуванням 280000 — і ця стеля там обов'язкова. Без неї запит
# обрізає не сервіс, а платформа, коли генерація не влазить у maxDuration
# (300 с): у відповіді тоді немає навіть нашого JSON, тому фронт показує голе
# «Помилка запиту (504)» без причини.
#
# Розмір ТЗ тут ні до чого — заміряно, що менше ТЗ падало там, де більше
# проходило. Час додають три речі, і жодна не залежить від обсягу відповіді:
# другий запит при розбіжності зі схемою, глибина adaptive-мислення (вона про
# складність теми) і власні повтори SDK на 429 та 529.
#
# Піднімати варто разом із maxDuration у nitro.config.ts, а не окремо: стеля
# більша за ліміт функції не працює — платформа однаково вб'є запит раніше.
# А вище за 300 с на Hobby не піднімається взагалі: це максимум тарифу.
# NITRO_AI_BUDGET_MS=280000

# ─── Доступ до сторінок конкурентів: каскад ────────────────────────────────
# Сторінка добувається послідовністю спроб — від безкоштовних і швидких до
# платних, а застаріла копія з архіву остання:
#
#   БЕЗКОШТОВНО   1. прямий запит
#                 2. власний Chrome           (немає на Vercel)
#                 3. сервіс читання r.jina.ai
#   ПЛАТНО        4. прямий запит через проксі
#                 5. Chrome через проксі
#                 6. Firecrawl                (ключем користувача, не звідси)
#                 7. зовнішній API рендерингу
#                 8. сервіс читання його резидентними адресами (треба ключ)
#   РЕЗЕРВ        9. наявна копія у Wayback Machine
#                10. копія на вимогу         (немає на Vercel)
#
# Платні ступені без налаштувань нижче просто не виконуються — усе інше
# працює й на порожньому файлі.
#
# Ступінь 6 — єдина, ключ якої тут не задається: він належить акаунту й
# додається в інтерфейсі («Налаштування» → «Доступ до закритих сторінок»).
# Так за важкі сторінки платить той, кому вони потрібні, зі свого ліміту, а не
# власник сервера за всіх. Тут для неї є лише таймаут.

# Стеля часу на весь каскад для однієї сторінки, мс. Сума таймаутів усіх
# ступеней — понад п'ять хвилин, і без цієї межі одна вперта сторінка тримала б
# увесь запит. Кожна наступна ступінь бере не більше, ніж лишилося.
# За замовчуванням 150000, на Vercel 120000 — там межа інша, її диктує ліміт
# тривалості функції.
# NITRO_FETCH_BUDGET_MS=150000

# ─── Ступені 3 і 8: сервіс читання (r.jina.ai) ─────────────────────────────
# Увімкнена за замовчуванням і безкоштовна. Сторінку відкриває чужий браузер
# із чужих адрес, а для нас це один HTTP-запит — тому вона працює й на Vercel,
# де свого Chrome немає в принципі.
#
# Заміряно на сайтах, де все інше безкоштовне впало: forbes.com — 5628 слів,
# zillow.com — 2230, trustpilot.com — 3099. Прямий запит на них дає 403.
#
# Ціна безкоштовності — близько 20 запитів на хвилину на IP сервера, далі
# сервіс відповідає 401. Вимикати варто лише тоді, коли адреси сторінок, які
# аналізують, не мають виходити за межі свого сервера: у цьому режимі вони
# передаються третій стороні.
# NITRO_READER_ENABLED=true
# NITRO_READER_TIMEOUT_MS=30000

# Ключ jina.ai (jina.ai/reader — видається безкоштовно). Знімає ліміт частоти
# й додатково відкриває ступінь 8: те саме читання, але резидентними адресами
# самого сервісу. Без ключа ступінь 8 не виконується — сервіс відповідає 401.
# NITRO_READER_KEY=jina_…

# ─── Ступінь 4 і 5: власний проксі ─────────────────────────────────────────
# Порожньо — вимкнені, каскад обходиться безкоштовними ступенями й архівом.
#
# Потрібні там, де блокують не запит, а діапазон IP: WAF закриває підмережі
# дата-центрів цілком, і сторінка, яка в браузері відкривається, з хостингу
# віддає 403.
#
# Формат — один URL з доступами. Потрібен саме HTTP-порт провайдера
# (інколи в кабінеті він зветься «HTTPS»); SOCKS5 не підтримується — його не
# вміє ні undici, ні Chromium з логіном і паролем.
#
# Символи @ : / ? # у паролі треба закодувати: @ → %40, : → %3A.
# Країна й номер сесії в резидентних провайдерів задаються в логіні
# (наприклад user-country-de-session-a1b2) — просто вставте логін як є.
#
# Трафік тарифікується за гігабайти, тому ступінь запускається лише після усіх
# безкоштовних і лише коли інший IP може щось змінити: на 403, 429 і обриви
# з'єднання, але не на 404 і не на JS-сторінку без тексту.

# NITRO_PROXY_URL=http://логін:пароль@gate.provider.com:8000

# Терпіння для запиту через проксі, мс. Резидентний шлюз додає рукостискання
# CONNECT і власну затримку, тому більше за NITRO_FETCH_TIMEOUT_MS.
# NITRO_PROXY_TIMEOUT_MS=25000

# ─── Ступінь 6: Firecrawl (ключ — в акаунті користувача) ───────────────────
# Тут задається лише терпіння: сам ключ у цьому файлі не живе. Його додає
# користувач у «Налаштування» → «Доступ до закритих сторінок», зашифрованим
# у таблиці user_fetch_keys, і кредити списуються з його рахунку.
#
# Робить те саме, що ступінь 7: відкриває сторінку своїм браузером із
# резидентної адреси й віддає готовий текст одним запитом. Іде першою з двох
# не за силою, а за рахунком — витрачати спільні серверні кредити раніше за
# власні користувача неправильно.
#
# Заміряно на двох сторінках, де прямий запит дає 403: forbes.com — 3684 слова,
# 23 заголовки, 5 FAQ; trustpilot.com — 2379 слів, 25 заголовків. Обидві по
# 1 кредиту.
#
# Терпіння більше за NITRO_SCRAPER_TIMEOUT_MS, бо промах кешу сервісу разом із
# підняттям до посиленої адреси довший за влучання (1 с проти 5–18 с), а на
# частині сторінок сервіс віддає 500 після 12–36 с. На Vercel цю цифру все одно
# обріже спільний бюджет каскаду.
# NITRO_FIRECRAWL_TIMEOUT_MS=45000

# ─── Ступінь 7: зовнішній API рендерингу ───────────────────────────────────
# Порожньо — вимкнена. Те саме, що ступінь 6, але спільним ключем сервера:
# чужий браузер із чужої резидентної адреси одним запитом, за всіх користувачів
# з одного рахунку. Дістається тим, хто власного ключа не додавав.
#
# Заміряно на шести сторінках, закритих гейтом Turnstile: цей API узяв чотири,
# а власний резидентний проксі й Chrome через нього — жодної. Тому вона стоїть
# перед ступенем 8 — читанням резидентними адресами jina, яке на тій самій
# вибірці не взяло жодної сторінки, витрачаючи по 30 с.
#
# Провайдер не зашитий — задається шаблоном адреси з підстановками {url}
# і {key}. Приклади (ключ підставляється з NITRO_SCRAPER_KEY):
#
#   https://api.scraperapi.com/?api_key={key}&url={url}
#   https://app.scrapingbee.com/api/v1/?api_key={key}&render_js=true&url={url}
#   https://api.zenrows.com/v1/?apikey={key}&js_render=true&premium_proxy=true&url={url}
#
# Увага на перший рядок: у ScraperAPI **не варто** додавати render=true.
# Заміряно — з ним гейт Turnstile не пробивається (500 після 56 с), а без нього
# сторінка приходить за 5–10 с і коштує 1 кредит замість 10.
#
# Вимога одна: сервіс має віддавати HTML сторінки тілом відповіді, а не JSON
# із полем. Провайдери з JSON-відповіддю тут не працюють.

# NITRO_SCRAPER_URL=
# NITRO_SCRAPER_KEY=

# Успішна відповідь приходить швидко (у ScraperAPI ≤11 с), а на невдачі сервіс
# тягне свої внутрішні повтори — там це ~56 с. Тому терпіння не «якнайбільше»,
# а трохи більше за успішний випадок.
# NITRO_SCRAPER_TIMEOUT_MS=40000
